        "terminal.ansi.bright_white": "#FFFFFFFF",
        "terminal.ansi.dim_black": "#0F111AFF",
        "terminal.ansi.dim_red": "#FF537080",
        "terminal.ansi.dim_green": "#C3E88D80",
        "terminal.ansi.dim_yellow": "#FFCB6B80",
        "terminal.ansi.dim_blue": "#82AAFF80",
        "terminal.ansi.dim_magenta": "#C792EA80",
        "terminal.ansi.dim_cyan": "#89DDFF80",
        "terminal.ansi.dim_white": "#8F93A280",

