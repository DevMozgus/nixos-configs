          { "cursor": "#82AAFFFF", "background": "#82AAFFFF", "selection": "#82AAFF30" },
          { "cursor": "#C792EAFF", "background": "#C792EAFF", "selection": "#C792EA30" },
          { "cursor": "#C3E88DFF", "background": "#C3E88DFF", "selection": "#C3E88D30" },
          { "cursor": "#FFCB6BFF", "background": "#FFCB6BFF", "selection": "#FFCB6B30" }
