        "border": "#1F2233FF",
        "border.variant": "#464B5D44",
        "border.focused": "#82AAFF80",
        "border.selected": "#82AAFF80",
        "border.transparent": "#464B5D00",
        "border.disabled": "#464B5D44",

        "text": "#EEFFFFCC",
        "text.muted": "#8F93A2FF",
