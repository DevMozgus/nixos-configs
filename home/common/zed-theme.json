        "modified.border": "#82AAFF60",
        "created": "#C3E88DFF",
        "created.background": "#C3E88D20",
        "created.border": "#C3E88D60",
        "deleted": "#FF5370FF",
        "deleted.background": "#FF537020",
        "deleted.border": "#FF537060",
        "ignored": "#464B5DFF",
        "ignored.background": "#464B5D20",
        "ignored.border": "#464B5D60",
        "renamed": "#89DDFFFF",
        "renamed.background": "#89DDFF20",
        "renamed.border": "#89DDFF60",
        "hidden": "#464B5DFF",
        "hidden.background": "#464B5D20",
        "hidden.border": "#464B5D60",
