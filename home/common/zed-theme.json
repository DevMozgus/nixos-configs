          "selector.pseudo":   { "color": "#FFCB6BFF" },
          "string":                    { "color": "#C3E88DFF" },
          "string.escape":             { "color": "#89DDFFFF" },
          "string.regex":              { "color": "#FF5370FF" },
          "string.special":            { "color": "#F07178FF" },
          "string.special.symbol":     { "color": "#F78C6CFF" },
          "tag":               { "color": "#F07178FF" },
          "text.literal":      { "color": "#C3E88DFF" },
          "title":             { "color": "#82AAFFFF" },
          "type":              { "color": "#FFCB6BFF" },
          "variable":          { "color": "#EEFFFFCC" },
          "variable.special":  { "color": "#C792EAFF" },
          "variant":           { "color": "#F07178FF" },
          "diff.plus":         { "color": "#C3E88DFF" },
          "diff.minus":        { "color": "#FF5370FF" }
        }
