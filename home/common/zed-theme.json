          "boolean":           { "color": "#F07178FF" },
          "comment":           { "color": "#464B5DFF", "font_style": "italic" },
          "comment.doc":       { "color": "#464B5DFF", "font_style": "italic" },
          "constant":          { "color": "#F78C6CFF" },
          "constructor":       { "color": "#82AAFFFF" },
          "embedded":          { "color": "#EEFFFFCC" },
          "emphasis":          { "color": "#C792EAFF", "font_style": "italic" },
          "emphasis.strong":   { "color": "#C792EAFF", "font_weight": 700 },
          "enum":              { "color": "#FFCB6BFF" },
          "function":          { "color": "#82AAFFFF" },
          "hint":              { "color": "#676E95FF" },
          "keyword":           { "color": "#C792EAFF" },
          "label":             { "color": "#82AAFFFF" },
